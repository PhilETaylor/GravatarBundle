{
    "name": "philetaylor/gravatar-bundle",
    "description": "FORKED!!! This bundles provides a Gravatar API various utilities to work with it in templates",
    "keywords": ["symfony", "gravatar", "templating", "twig"],
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [{
        "name" : "Thibault Duplessis",
        "email" : "thibault.duplessis@gmail.com"
    },
    {
        "name" : "Henrik Bjørnskov",
        "email" : "henrik@bjrnskov.dk"
    }],
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle" : "^6.4|^7.0|^8.0",
        "symfony/templating": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^6.4|^7.0|^8.0"
    },
    "suggest" : {
        "twig/twig" : "For gravatar twig extension usage"
    },
    "autoload": {
        "psr-4": {
            "Ornicar\\GravatarBundle\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "8.0-dev"
        }
    }
}
